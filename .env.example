# LLM Hub — Environment Variables
# Copy this file to .env and fill in values as needed.
# Most configuration lives in config.json — these env vars let you override
# specific values without editing the JSON file (useful for CI/Docker/secrets managers).

# ─── Server ───────────────────────────────────────────────────────────────────

# Port the proxy server listens on (overrides config.json proxy_port)
# LLM_HUB_PORT=8765

# Directory for RAG vector data and uploads (overrides config.json storage_dir)
# LLM_HUB_STORAGE_DIR=.llm-hub

# ─── Local Providers ──────────────────────────────────────────────────────────

# Ollama server (overrides config.json providers.ollama)
# LLM_HUB_OLLAMA_HOST=localhost
# LLM_HUB_OLLAMA_PORT=11434

# LM Studio server (overrides config.json providers.lmstudio)
# LLM_HUB_LMSTUDIO_HOST=localhost
# LLM_HUB_LMSTUDIO_PORT=1234

# Whisper transcription server (overrides config.json whisper)
# LLM_HUB_WHISPER_HOST=localhost
# LLM_HUB_WHISPER_PORT=8000

# ─── Cloud Provider API Keys ──────────────────────────────────────────────────
# These can also be set per-session in the UI (stored in localStorage, not on disk).
# Setting them here makes them available server-side for all sessions.

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...

# ─── MCP Server Tokens ────────────────────────────────────────────────────────
# API keys for MCP servers configured in config.json mcp_servers[].env

# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...
# BRAVE_API_KEY=BSA...

# ─── Node.js Runtime ──────────────────────────────────────────────────────────

# Set to 'production' to suppress verbose logging
# NODE_ENV=development

# Minimum required: Node.js >= 18.0.0
